## Copy this file to `.env` and fill in real values locally.
## Never commit real credentials to Git.

# Database
# Example format (replace placeholders in your local .env only):
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?appName=<app-name>/<db-name>

# Dev
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/?appName=Cluster0/animestore-dev

# Redis is disabled for local/dev for now.
# Enable it only in production if traffic grows enough to need caching/sessions.
# REDIS_URL=redis://<production-redis-host>:6379

# JWT
JWT_SECRET=change_me_super_secret_jwt_key
JWT_REFRESH_SECRET=change_me_super_secret_refresh_key
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3001

# Email (if needed)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_app_password

# Payment Gateway (example)
STRIPE_SECRET_KEY=sk_test_...
PAYPAL_CLIENT_ID=...
PAYPAL_CLIENT_SECRET=...

# Other
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100