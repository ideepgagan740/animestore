{
  "name": "anime-store-backend",
  "version": "1.0.0",
  "description": "Production-ready backend for Anime Store using Clean Architecture",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "docker:build": "docker build -t anime-store-backend .",
    "docker:run": "docker run -p 3000:3000 anime-store-backend",
    "update-diagram": "node scripts/update-diagram.js",
    "validate-diagram": "node scripts/update-diagram.js validate",
    "analyze-codebase": "node scripts/update-diagram.js analyze",
    "update-docs": "node scripts/update-diagram.js docs",
    "maintain-docs": "node scripts/update-diagram.js all"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/ideepgagan740/animestore.git"
  },
  "author": "Gagandeep singh",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/ideepgagan740/animestore/issues"
  },
  "homepage": "https://github.com/ideepgagan740/animestore#readme",
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^7.5.0",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "redis": "^4.6.8",
    "helmet": "^7.0.0",
    "cors": "^2.8.5",
    "express-rate-limit": "^6.10.0",
    "joi": "^17.9.2",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^4.6.3",
    "inversify": "^6.0.1",
    "reflect-metadata": "^0.2.2",
    "dotenv": "^16.3.1",
    "winston": "^3.10.0",
    "express-async-errors": "^3.1.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/node": "^20.5.7",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/bcryptjs": "^2.4.4",
    "@types/cors": "^2.8.13",
    "@types/swagger-jsdoc": "^6.0.1",
    "@types/swagger-ui-express": "^4.1.3",
    "@types/jest": "^29.5.4",
    "@types/supertest": "^2.0.12",
    "typescript": "^5.1.6",
    "ts-node-dev": "^2.0.0",
    "jest": "^29.6.2",
    "supertest": "^6.3.3",
    "eslint": "^8.47.0",
    "@typescript-eslint/eslint-plugin": "^6.4.0",
    "@typescript-eslint/parser": "^6.4.0",
    "prettier": "^3.0.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/src"],
    "testMatch": ["**/__tests__/**/*.test.ts", "**/?(*.)+(spec|test).ts"],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts",
      "!src/index.ts"
    ]
  }
}
